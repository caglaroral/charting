CH_URL=http://127.0.0.1:8123
CH_USER=default
CH_PASSWORD=
CH_APP_DB=charting
CH_MARKET_DB=default
HOST=0.0.0.0
PORT=8080
# Authentication provider:
#   local  - username/password stored in charting.users, cookie sessions
#   header - trust an identity header set by an auth proxy in front of the app
#            (oauth2-proxy, IAM gateway ...). Users are auto-provisioned.
#   none   - single-user dev mode, everything belongs to user "dev"
AUTH_MODE=local
AUTH_HEADER_USER=X-Auth-Request-User
AUTH_HEADER_EMAIL=X-Auth-Request-Email
AUTH_HEADER_PROVIDER=proxy
SESSION_DAYS=30
